#!/usr/bin/env kbb
(require '[babashka.classpath :as cp] '[babashka.fs :as fs] '[clojure.test :as t])
(let [here (fs/parent (fs/absolutize *file*))]
  (cp/add-classpath (str (fs/path here "src-clj")))
  (cp/add-classpath (str (fs/path here "test-clj")))
  ;; the frontier is a sibling provider, not a copy: control sits ON it, and
  ;; duplicating the file would give the crawl two policies that drift apart.
  (cp/add-classpath (str (fs/path here ".." "crawler-frontier" "src-clj"))))
(require 'etzhayyim.crawler.page-test 'etzhayyim.crawler.control-test)
(let [{:keys [fail error]} (t/run-tests 'etzhayyim.crawler.page-test 'etzhayyim.crawler.control-test)]
  (println (if (zero? (+ fail error))
             "── crawler-control (page): green ──"
             "── crawler-control (page): FAILURES above ──"))
  (System/exit (if (zero? (+ fail error)) 0 1)))
