#!/usr/bin/env kbb
;; bb-native runner for the indexer port (repo convention: operational code is
;; clj/bb, no shell).
(require '[babashka.classpath :as cp] '[babashka.fs :as fs] '[clojure.test :as t])
(let [here (fs/parent (fs/absolutize *file*))]
  (cp/add-classpath (str (fs/path here "src-clj")))
  (cp/add-classpath (str (fs/path here "test-clj"))))
(require 'etzhayyim.crawler.indexer-test)
(let [{:keys [fail error]} (t/run-tests 'etzhayyim.crawler.indexer-test)]
  (println (if (zero? (+ fail error))
             "── crawler-indexer: green ──"
             "── crawler-indexer: FAILURES above ──"))
  (System/exit (if (zero? (+ fail error)) 0 1)))
