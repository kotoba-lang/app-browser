{
  "name": "darkweb-proxy",
  "main": "worker.ts",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "DarkwebProxy",
      "image": "registry.cloudflare.com/4da88288dc30d9ee257f319d3c33ecf0/darkweb-proxy-darkwebproxy@sha256:f5460ca4909b318c6578fca3616fa34bbfa0a0ae50594f660ffe9d8bde11bc95",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DARKWEB_PROXY", "class_name": "DarkwebProxy" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DarkwebProxy"] }
  ],
  "routes": [
    {
      "pattern": "darkweb-proxy.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "vars": {
    "APP_FRAMEWORK": "container-companion",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  }
}
